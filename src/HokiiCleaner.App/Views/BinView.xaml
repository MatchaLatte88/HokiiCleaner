<UserControl x:Class="HokiiCleaner.App.Views.BinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf: Summe und Aktionen -->
        <Grid Grid.Row="0" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PAPIERKORB" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Bin.SummaryText}" Margin="0,4,0,0" FontSize="{StaticResource FontSizeSubtitle}"
                           Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" />
                <TextBlock Text="Der Platz wird erst frei, wenn der Papierkorb geleert ist. Bis dahin lässt sich alles wiederherstellen."
                           Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Bin.NoteText}" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Bin.HasNote, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding Bin.ShowActions, Converter={StaticResource BoolToVis}}">
                <Button Content="Neu lesen" Style="{StaticResource SecondaryButton}" Padding="12,9" Margin="0,0,8,0"
                        Command="{Binding Bin.RefreshCommand}" />
                <Button Content="Im Explorer öffnen" Style="{StaticResource SecondaryButton}" Padding="12,9" Margin="0,0,8,0"
                        Command="{Binding Bin.OpenInExplorerCommand}" />
                <Button Content="Papierkorb leeren …" Style="{StaticResource DangerButton}" Padding="14,9"
                        Command="{Binding Bin.RequestEmptyCommand}"
                        ToolTip="Löscht alles im Papierkorb endgültig (fragt vorher nach)" />
            </StackPanel>
        </Grid>

        <!-- Liste -->
        <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" />
        <ListBox Grid.Row="1" Margin="8,10,8,10" Style="{StaticResource PlainList}"
                 ItemContainerStyle="{StaticResource CategoryRowItem}"
                 ItemsSource="{Binding Bin.Rows}"
                 Visibility="{Binding Bin.HasRows, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{Binding Entry.OriginalPath}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OriginalFolder}" Style="{StaticResource DimText}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeCaption}" TextAlignment="Right">
                                <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · gelöscht " /><Run Text="{Binding DeletedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Wiederherstellen" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                VerticalAlignment="Center"
                                ToolTip="Legt den Eintrag an seinen ursprünglichen Ort zurück; überschreibt nichts"
                                Command="{Binding DataContext.Bin.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding Bin.ShowEmptyHint, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Nichts zum Anzeigen." FontSize="{StaticResource FontSizeSubtitle}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Hier erscheinen Einträge, die du über den Auswahlkorb in den Papierkorb gelegt hast, und alles, was du sonst in Windows gelöscht hast." />
        </StackPanel>

        <!-- Aktionsleiste: Ergebnis, Bestaetigung oder Fortschritt -->
        <Grid Grid.Row="2" Margin="0,14,0,0"
              Visibility="{Binding Bin.NeedsBar, Converter={StaticResource BoolToVis}}">
            <ContentControl Style="{StaticResource GlassCard}" />
            <Grid Margin="20,14" Visibility="{Binding Bin.IsConfirmingEmpty, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Bin.ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Command="{Binding Bin.CancelEmptyCommand}" />
                    <Button Content="Endgültig leeren" Style="{StaticResource DangerButton}"
                            Command="{Binding Bin.ConfirmEmptyCommand}" />
                </StackPanel>
            </Grid>
            <TextBlock Margin="20,14" Text="{Binding Bin.ResultText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{Binding Bin.ShowResultOnly, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
