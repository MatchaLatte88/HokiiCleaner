<UserControl x:Class="HokiiCleaner.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <!-- Gemessene Größen in Akzentfarbe, geschätzte neutral -->
        <Style x:Key="SizeBar" TargetType="ProgressBar" BasedOn="{StaticResource ShareBar}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Überschrift, Zusammenfassung, Hinweis -->
        <Grid Grid.Row="0" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PROGRAMME NACH GRÖSSE" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Programs.SummaryText}" Margin="0,4,0,0" FontSize="{StaticResource FontSizeSubtitle}"
                           Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Programs.NoteText}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="980"
                           Visibility="{Binding Programs.HasNote, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Programs.ErrorText}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="{Binding Programs.HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Exportieren …" Style="{StaticResource SecondaryButton}" Padding="12,5" VerticalAlignment="Top"
                    ToolTip="Die Programmliste als CSV-Datei speichern (öffnet einen Speichern-Dialog)"
                    Command="{Binding Programs.ExportCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.8*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" />
            <ListBox Grid.Column="0" Margin="8,10,8,10" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource CategoryRowItem}"
                     ItemsSource="{Binding Programs.Rows}"
                     SelectedItem="{Binding Programs.SelectedRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeText}" Margin="12,0,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0" Value="{Binding ShareValue, Mode=OneWay}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource SizeBar}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMeasured}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DetailText}" Style="{StaticResource DimText}"
                                       FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="2" Style="{StaticResource GlassCard}" />
            <StackPanel Grid.Column="2" Margin="22,20,22,18"
                        Visibility="{Binding Programs.HasSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="AUSGEWÄHLTES PROGRAMM" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Programs.SelectedRow.Name}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Programs.SelectedRow.DetailText}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding Programs.SelectedRow.SizeText}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeDisplay}" Typography.NumeralAlignment="Tabular" Margin="0,16,0,0" />
                <TextBlock Text="{Binding Programs.SelectedRow.SizeNote}" Style="{StaticResource DimText}" Margin="0,2,0,0" />

                <TextBlock Text="INSTALLATIONSORDNER" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                <TextBlock Text="{Binding Programs.SelectedRow.LocationText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Programs.SelectedRow.Source}" Style="{StaticResource DimText}"
                           FontSize="{StaticResource FontSizeCaption}" Margin="0,6,0,0" />

                <WrapPanel Margin="0,18,0,0">
                    <Button Content="In Orte zeigen" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,8"
                            ToolTip="Öffnet den Installationsordner in der Orte-Ansicht"
                            Command="{Binding Programs.ShowInPlacesCommand}" />
                    <Button Content="Im Explorer zeigen" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                            Command="{Binding Programs.RevealCommand}" />
                    <Button Content="Pfad kopieren" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                            Command="{Binding Programs.CopyPathCommand}" />
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Deinstallieren …" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                            Command="{Binding Programs.RequestUninstallCommand}"
                            ToolTip="Startet den Deinstaller des Herstellers nach einer Rückfrage; HokiiCleaner löscht dabei selbst nichts" />
                    <Button Content="Apps &amp; Features" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                            Command="{Binding Programs.OpenAppsSettingsCommand}"
                            ToolTip="Öffnet die Programmliste in den Windows-Einstellungen" />
                </WrapPanel>
                <StackPanel Margin="0,4,0,8" Visibility="{Binding Programs.IsConfirmingUninstall, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Deinstaller dieses Programms starten?" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="HokiiCleaner startet den Befehl, den der Hersteller bei Windows hinterlegt hat, und löscht selbst nichts. Was danach passiert, bestimmt der Deinstaller." />
                    <TextBlock Text="{Binding Programs.SelectedRow.UninstallText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding Programs.CancelUninstallCommand}" />
                        <Button Content="Deinstaller starten" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                Command="{Binding Programs.ConfirmUninstallCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"
                           Text="HokiiCleaner löscht keine Programmordner. Zum Entfernen den Deinstaller des Programms nutzen." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
