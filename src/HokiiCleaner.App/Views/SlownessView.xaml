<UserControl x:Class="HokiiCleaner.App.Views.SlownessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <!-- Farbe nur bei Abweichung: Marker und Etikett folgen der Schwere -->
        <Style x:Key="OutcomeMarker" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Info">
                    <Setter Property="Background" Value="{DynamicResource TextDimBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutcomeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Ok">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chevron" TargetType="TextBlock" BasedOn="{StaticResource DimText}">
            <Setter Property="Text" Value="▸" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCollapsible}" Value="True" />
                        <Condition Binding="{Binding IsOpen}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="▾" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Slow.ShowEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Warum ist mein Rechner langsam?" FontSize="{StaticResource FontSizeSubtitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="HokiiCleaner misst Laufwerk, Autostart, Prozesse und Einstellungen. Das dauert etwa zehn Sekunden."
                       Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="Die Messung liest nur. Es wird nichts verändert oder gelöscht."
                       Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                    Visibility="{Binding Slow.ShowError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Die Messung ist fehlgeschlagen." FontSize="{StaticResource FontSizeSubtitle}"
                       Foreground="{DynamicResource CriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Slow.ErrorText}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding Slow.ShowContent, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Slow.HeroNumber}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding Slow.HeroLabel}" Style="{StaticResource DimText}"
                               FontSize="{StaticResource FontSizeSubtitle}" VerticalAlignment="Bottom" Margin="10,0,0,9" />
                </StackPanel>
                <TextBlock Text="{Binding Slow.HeroCaption}" Style="{StaticResource DimText}" Margin="0,2,0,0"
                           Typography.NumeralAlignment="Tabular" />
                <ProgressBar Style="{StaticResource ShareBar}" Margin="0,14,0,0" MaxWidth="520" HorizontalAlignment="Left"
                             Value="{Binding Slow.Fraction, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding Slow.IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Slow.NoteText}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,10,0,0"
                           Visibility="{Binding Slow.HasNote, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Button Grid.Row="0" Content="Exportieren …" Style="{StaticResource SecondaryButton}" Padding="12,5"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding Slow.ExportCommand}"
                    ToolTip="Den Bericht als JSON-Datei speichern (öffnet einen Speichern-Dialog)"
                    Visibility="{Binding Slow.HasResult, Converter={StaticResource BoolToVis}}" />

            <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" />
            <ScrollViewer Grid.Row="1" Margin="14,14,10,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Slow.Groups}" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <ToggleButton Style="{StaticResource GroupHeaderToggle}"
                                              IsEnabled="{Binding IsCollapsible}"
                                              IsChecked="{Binding IsOpen, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Eyebrow}" Margin="8,0,0,0" />
                                        <TextBlock Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </ToggleButton>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource OutcomeMarker}" />
                                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding OutcomeText}" Style="{StaticResource OutcomeLabel}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Measurement}" Style="{StaticResource DimText}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding AreaText}" Style="{StaticResource Eyebrow}"
                                                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    </Grid>
                                                </ToggleButton>

                                                <StackPanel Margin="29,0,12,12" MaxWidth="820" HorizontalAlignment="Left"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Threshold}" Style="{StaticResource DimText}"
                                                               FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding HasThreshold, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Explanation}" FontSize="{StaticResource FontSizeSmall}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0"
                                                                  Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                                                                           TextWrapping="Wrap" Margin="0,1,0,0">
                                                                    <Run Text="–  " /><Run Text="{Binding Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource DimText}"
                                                               FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
