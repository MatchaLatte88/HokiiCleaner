<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Glas, hell". Dieselben Schluessel wie Dark.xaml; nur die Werte unterscheiden sich. -->

    <Color x:Key="SurfaceBaseColor">#EAF1F5</Color>
    <Color x:Key="TextColor">#0E2A33</Color>
    <Color x:Key="TextDimColor">#5C7A84</Color>
    <Color x:Key="AccentColor">#E8890C</Color>
    <Color x:Key="ShadowColor">#0E2A33</Color>

    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#EAF1F5" />
    <RadialGradientBrush x:Key="GlowBlueBrush">
        <GradientStop Color="#596C9BFF" Offset="0" />
        <GradientStop Color="#006C9BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPinkBrush">
        <GradientStop Color="#59FF9AD0" Offset="0" />
        <GradientStop Color="#00FF9AD0" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowTealBrush">
        <GradientStop Color="#666FE3D2" Offset="0" />
        <GradientStop Color="#006FE3D2" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#0A0E2A33" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#140E2A33" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1F0E2A33" />

    <SolidColorBrush x:Key="GlassFillBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="GlassStrongFillBrush" Color="#D1FFFFFF" />
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#66FFFFFF" Offset="0.55" />
        <GradientStop Color="#B3FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassOutlineBrush" Color="#1F0E2A33" />

    <SolidColorBrush x:Key="TextBrush" Color="#0E2A33" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#5C7A84" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8890C" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D9531E" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C62839" />
    <SolidColorBrush x:Key="OkBrush" Color="#1F9D72" />

    <SolidColorBrush x:Key="TrackBrush" Color="#120E2A33" />
    <SolidColorBrush x:Key="TickBrush" Color="#330E2A33" />
    <SolidColorBrush x:Key="TickMajorBrush" Color="#800E2A33" />
</ResourceDictionary>
