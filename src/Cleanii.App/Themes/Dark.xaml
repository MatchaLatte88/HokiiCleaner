<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Glas, dunkel". Dieselben Schluessel wie Light.xaml; nur die Werte unterscheiden sich. -->

    <Color x:Key="SurfaceBaseColor">#0A1224</Color>
    <Color x:Key="TextColor">#F3F8FF</Color>
    <Color x:Key="TextDimColor">#A9BBD0</Color>
    <Color x:Key="AccentColor">#FFC970</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Hintergrund: Basisfarbe plus drei weiche Lichtflecken -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#0A1224" />
    <RadialGradientBrush x:Key="GlowBlueBrush">
        <GradientStop Color="#8C3678FF" Offset="0" />
        <GradientStop Color="#003678FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowPinkBrush">
        <GradientStop Color="#6BFF46AA" Offset="0" />
        <GradientStop Color="#00FF46AA" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowTealBrush">
        <GradientStop Color="#6100CDB9" Offset="0" />
        <GradientStop Color="#0000CDB9" Offset="1" />
    </RadialGradientBrush>

    <!-- Flaechen der Listen und Karten -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />

    <!-- Glas: Fuellung, Randlicht (Verlauf) und aeusserer Umriss -->
    <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassStrongFillBrush" Color="#1FFFFFFF" />
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#52FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.55" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassOutlineBrush" Color="#33000000" />

    <!-- Text und Akzent: Farbe nur bei Abweichung -->
    <SolidColorBrush x:Key="TextBrush" Color="#F3F8FF" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#A9BBD0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC970" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#2A1A00" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF8F5B" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#FF5C6C" />
    <SolidColorBrush x:Key="OkBrush" Color="#5FD3A5" />

    <!-- Ring: Spur und Skala -->
    <SolidColorBrush x:Key="TrackBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TickBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="TickMajorBrush" Color="#99FFFFFF" />
</ResourceDictionary>
