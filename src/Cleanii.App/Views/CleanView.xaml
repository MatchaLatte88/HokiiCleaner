<UserControl x:Class="Cleanii.App.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <!-- Hauptinhalt verschwindet nur bei einem Fehler -->
        <Style x:Key="MainGrid" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Clean.ShowError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ziele ohne Treffer bleiben sichtbar, aber zurueckgenommen -->
        <Style x:Key="TargetRow" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanSelect}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                    Visibility="{Binding Clean.ShowError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Aufräumen ist fehlgeschlagen." FontSize="{StaticResource FontSizeSubtitle}"
                       Foreground="{DynamicResource CriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Clean.ErrorText}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
            <Button Content="Neu prüfen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                    Margin="0,14,0,0" Command="{Binding Clean.AnalyzeCommand}" />
        </StackPanel>

        <Grid Style="{StaticResource MainGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopf: Summe aller gefundenen Bereiche -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Clean.HeroNumber}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding Clean.HeroUnit}" Style="{StaticResource DimText}"
                               FontSize="{StaticResource FontSizeSubtitle}" VerticalAlignment="Bottom" Margin="10,0,0,9" />
                </StackPanel>
                <TextBlock Text="{Binding Clean.HeroCaption}" Style="{StaticResource DimText}" Margin="0,2,0,0"
                           TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
            </StackPanel>

            <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" />
            <ScrollViewer Grid.Row="1" Margin="18,18,10,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,0">
                    <!-- Ergebnis des letzten Loeschlaufs -->
                    <StackPanel Margin="0,0,0,26" Visibility="{Binding Clean.HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LETZTES AUFRÄUMEN" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding Clean.ResultTitle}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource FontSizeTitle}" Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Clean.ResultNote}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Clean.ResultLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                               MaxWidth="820" HorizontalAlignment="Left" Margin="0,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Protokoll zeigen" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding Clean.RevealLogCommand}"
                                Visibility="{Binding Clean.HasLog, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Clean.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Style="{StaticResource TargetRow}" Margin="0,0,0,22">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Style="{StaticResource GlassCheckBox}" Margin="0,1,16,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding TierText}" Style="{StaticResource Eyebrow}"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Consequence}" Style="{StaticResource DimText}"
                                                                   FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource CriticalBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding PathsText}" Style="{StaticResource DimText}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PathsText}" Margin="0,8,0,0" />
                                                        <ItemsControl ItemsSource="{Binding LargestItems}" Margin="0,4,0,0"
                                                                      Visibility="{Binding HasLargest, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource DimText}"
                                                                               FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="20,0,0,0" MinWidth="150">
                                                        <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}"
                                                                   FontSize="{StaticResource FontSizeTitle}" TextAlignment="Right"
                                                                   Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource DimText}"
                                                                   FontSize="{StaticResource FontSizeSmall}" TextAlignment="Right" Margin="0,2,0,0"
                                                                   Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Aktionsleiste: Auswahl, Bestaetigung oder Fortschritt -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ContentControl Style="{StaticResource GlassCard}" />

                <Grid Margin="20,14" Visibility="{Binding Clean.ShowSelectionBar, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Clean.SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <Button Grid.Column="1" Content="Endgültig löschen …" Style="{StaticResource DangerButton}"
                            Command="{Binding Clean.RequestCleanCommand}" />
                </Grid>

                <Grid Margin="20,14" Visibility="{Binding Clean.IsConfirming, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Clean.ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Command="{Binding Clean.CancelConfirmCommand}" />
                        <Button Content="Endgültig löschen" Style="{StaticResource DangerButton}"
                                Command="{Binding Clean.ConfirmCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="20,14" Visibility="{Binding Clean.IsCleaning, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding Clean.ProgressText}" Typography.NumeralAlignment="Tabular" />
                        <ProgressBar Style="{StaticResource ShareBar}" Margin="0,10,0,0" Maximum="1"
                                     Value="{Binding Clean.ProgressFraction, Mode=OneWay}" Foreground="{DynamicResource CriticalBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Abbrechen" Style="{StaticResource SecondaryButton}"
                            Command="{Binding Clean.CancelCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
