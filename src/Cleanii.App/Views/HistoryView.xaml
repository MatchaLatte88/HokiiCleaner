<UserControl x:Class="Cleanii.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="ChangeBar" TargetType="ProgressBar" BasedOn="{StaticResource ShareBar}">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGrowth}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VERLAUF" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding History.SummaryText}" Margin="0,4,0,0" FontSize="{StaticResource FontSizeSubtitle}" />
                <TextBlock Text="{Binding History.CurrentScanText}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" MaxWidth="900" Margin="0,4,0,0"
                           Text="Ein gespeicherter Stand hält die Größe aller Ordner ab 50 MB fest (Pfade und Größen, keine Dateiinhalte) und bleibt auf diesem Rechner. Nach einem späteren Scan desselben Ordners siehst du, was gewachsen ist." />
                <TextBlock Text="{Binding History.NoteText}" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding History.HasNote, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding History.ErrorText}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding History.HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Stand speichern" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,0,8,0"
                        Command="{Binding History.SaveCommand}"
                        ToolTip="Speichert den aktuellen Scan als Stand im Ordner von Cleanii" />
                <Button Content="Ordner öffnen" Style="{StaticResource SecondaryButton}" Padding="12,9"
                        Command="{Binding History.OpenFolderCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.5*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Gespeicherte Staende -->
            <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" />
            <Grid Grid.Column="0" Margin="8,10,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CategoryRowItem}"
                         ItemsSource="{Binding History.Items}"
                         SelectedItem="{Binding History.SelectedItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TakenText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                                <TextBlock Text="{Binding RootPath}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="12,6,12,0" VerticalAlignment="Top"
                           Visibility="{Binding History.ShowNoItems, Converter={StaticResource BoolToVis}}"
                           Text="Noch kein Stand gespeichert. Mit „Stand speichern“ oben hältst du fest, wie groß jeder Ordner jetzt ist. Nach einem späteren Scan desselben Ordners siehst du hier, was gewachsen ist." />
                <StackPanel Grid.Row="1" Margin="10,10,10,4">
                    <WrapPanel>
                        <Button Content="Mit aktuellem Scan vergleichen" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,8,8"
                                Command="{Binding History.CompareCommand}"
                                ToolTip="Nur für Stände desselben Ordners wie der aktuelle Scan" />
                        <Button Content="Stand löschen …" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                                Command="{Binding History.RequestDeleteCommand}" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding History.IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Diesen gespeicherten Stand endgültig löschen? Er lässt sich nicht wiederherstellen." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                    Command="{Binding History.CancelDeleteCommand}" />
                            <Button Content="Löschen" Style="{StaticResource DangerButton}" Padding="12,6"
                                    Command="{Binding History.ConfirmDeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Vergleich -->
            <ContentControl Grid.Column="2" Style="{StaticResource GlassCard}" />
            <Grid Grid.Column="2" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WAS SICH GEÄNDERT HAT" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding History.ResultText}" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap" Margin="0,4,12,0" Visibility="{Binding History.HasResult, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Exportieren …" Style="{StaticResource SecondaryButton}" Padding="12,5" VerticalAlignment="Top"
                            Command="{Binding History.ExportCommand}"
                            ToolTip="Den Vergleich als CSV-Datei speichern (öffnet einen Speichern-Dialog)" />
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="10,6,10,0" VerticalAlignment="Top"
                           Visibility="{Binding History.ShowCompareHint, Converter={StaticResource BoolToVis}}"
                           Text="Wähle links einen gespeicherten Stand und klicke auf „Mit aktuellem Scan vergleichen“. Das geht nur für Stände desselben Ordners wie der aktuelle Scan." />
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CategoryRowItem}"
                         ItemsSource="{Binding History.Changes}"
                         Visibility="{Binding History.HasChanges, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding DeltaText}" FontWeight="SemiBold" Margin="12,0,0,0"
                                           Typography.NumeralAlignment="Tabular" />
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ChangeBar}" Margin="0,7,0,0"
                                             Value="{Binding ShareValue, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}"
                                           Margin="0,5,0,0" Typography.NumeralAlignment="Tabular">
                                    <Run Text="{Binding OldText, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding NewText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
