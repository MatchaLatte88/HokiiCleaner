<UserControl x:Class="Cleanii.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Duplicates.IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Suchbereich, Mindestgröße, Start -->
        <Grid Grid.Row="0" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DUPLIKATE" Style="{StaticResource Eyebrow}" />
                <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeSubtitle}" TextWrapping="Wrap"
                           Typography.NumeralAlignment="Tabular">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Findet Dateien mit identischem Inhalt im Ordner der Orte-Ansicht und darunter." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Duplicates.ShowResult}" Value="True">
                                    <Setter Property="Text" Value="{Binding Duplicates.SummaryText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Duplicates.IsRunning}" Value="True">
                                    <Setter Property="Text" Value="{Binding Duplicates.ProgressText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Duplicates.ShowError}" Value="True">
                                    <Setter Property="Text" Value="Die Suche ist fehlgeschlagen." />
                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Style="{StaticResource ShareBar}" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left"
                             Value="{Binding Duplicates.Fraction, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding Duplicates.IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Duplicates.ErrorText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding Duplicates.ShowError, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Duplicates.NoteText}" Foreground="{DynamicResource WarningBrush}"
                           FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" MaxWidth="980" Margin="0,4,0,0"
                           Visibility="{Binding Duplicates.HasNote, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0"
                           Text="{Binding Duplicates.ScopeText, StringFormat=Durchsucht: {0}}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Duplicates.IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="AB" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton GroupName="DupMin" Content="1 MB" Style="{StaticResource FilterChip}" Margin="0,0,4,0"
                             IsChecked="{Binding Duplicates.Min1, Mode=TwoWay}" IsEnabled="{Binding Duplicates.CanChangeOptions}" />
                <RadioButton GroupName="DupMin" Content="10 MB" Style="{StaticResource FilterChip}" Margin="0,0,4,0"
                             IsChecked="{Binding Duplicates.Min10, Mode=TwoWay}" IsEnabled="{Binding Duplicates.CanChangeOptions}" />
                <RadioButton GroupName="DupMin" Content="100 MB" Style="{StaticResource FilterChip}" Margin="0,0,14,0"
                             IsChecked="{Binding Duplicates.Min100, Mode=TwoWay}" IsEnabled="{Binding Duplicates.CanChangeOptions}" />
                <Grid>
                    <Button Content="Duplikate suchen" Style="{StaticResource StartButton}" Command="{Binding Duplicates.StartCommand}" />
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Command="{Binding Duplicates.CancelCommand}"
                            Visibility="{Binding Duplicates.IsRunning, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Button Content="Exportieren …" Style="{StaticResource SecondaryButton}" Padding="12,9" Margin="8,0,0,0"
                        ToolTip="Den Bericht als CSV-Datei speichern (öffnet einen Speichern-Dialog)"
                        Command="{Binding Duplicates.ExportCommand}" />
            </StackPanel>
        </Grid>

        <!-- Leerer Zustand -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                    Visibility="{Binding Duplicates.ShowIdle, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Wo liegen Kopien derselben Datei?" FontSize="{StaticResource FontSizeSubtitle}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Cleanii vergleicht zuerst die Größe, dann Anfang und Ende und zuletzt den ganzen Inhalt (SHA-256). Das liest die Dateien einmal und kann bei vielen großen Dateien dauern. Gesucht wird in dem Ordner, der in der Orte-Ansicht geöffnet ist." />
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Gefundene Kopien kannst du für den Papierkorb vormerken; in jeder Gruppe bleibt mindestens eine. Verschoben wird erst nach deiner Bestätigung, und du kannst sie im Papierkorb wiederherstellen." />
        </StackPanel>

        <!-- Ergebnis ohne Treffer -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                    Visibility="{Binding Duplicates.ShowNoDuplicates, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Keine Kopien gefunden." FontSize="{StaticResource FontSizeSubtitle}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Im durchsuchten Ordner gibt es keine zwei Dateien mit gleichem Inhalt in der gewählten Mindestgröße. Eine kleinere Mindestgröße oder ein größerer Ordner in der Orte-Ansicht findet mehr." />
        </StackPanel>

        <!-- Ergebnis: Gruppen links, Dateien der gewählten Gruppe rechts -->
        <Grid Grid.Row="1" Visibility="{Binding Duplicates.ShowGroups, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" />
            <ListBox Grid.Column="0" Margin="8,10,8,10" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource CategoryRowItem}"
                     ItemsSource="{Binding Duplicates.Groups}"
                     SelectedItem="{Binding Duplicates.SelectedGroup, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReclaimText}" Margin="12,0,0,0"
                                       Typography.NumeralAlignment="Tabular" ToolTip="Platz, der frei würde, wenn nur eine Kopie bliebe" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ShareBar}" Margin="0,7,0,0"
                                         Value="{Binding ShareValue, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CountText}" Style="{StaticResource DimText}"
                                       FontSize="{StaticResource FontSizeSmall}" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="2" Style="{StaticResource GlassCard}" />
            <Grid Grid.Column="2" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="KOPIEN DER GEWÄHLTEN GRUPPE" Style="{StaticResource Eyebrow}" Margin="10,0,0,8" />
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CategoryRowItem}"
                         ItemsSource="{Binding Duplicates.Files}"
                         SelectedItem="{Binding Duplicates.SelectedFile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource MarkCheckBox}" Margin="0,0,12,0" VerticalAlignment="Top"
                                          IsChecked="{Binding IsMarked, Mode=TwoWay}" IsEnabled="{Binding CanMark}"
                                          ToolTip="{Binding MarkToolTip}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DirectoryPath}" Style="{StaticResource DimText}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource DimText}"
                                               FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="10,12,0,0">
                    <WrapPanel>
                        <Button Content="Im Ordner zeigen" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,8"
                                ToolTip="Öffnet den Ordner der gewählten Kopie in der Orte-Ansicht"
                                Command="{Binding Duplicates.ShowInFolderCommand}" />
                        <Button Content="Im Explorer zeigen" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                                Command="{Binding Duplicates.RevealCommand}" />
                        <Button Content="Pfad kopieren" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,8"
                                Command="{Binding Duplicates.CopyPathCommand}" />
                    </WrapPanel>
                    <TextBlock Text="KOPIEN VORMERKEN" Style="{StaticResource Eyebrow}" Margin="0,6,0,6" />
                    <WrapPanel>
                        <Button Content="Älteste behalten" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                Command="{Binding Duplicates.KeepOldestCommand}"
                                ToolTip="In jeder Gruppe die älteste Kopie behalten und alle anderen vormerken" />
                        <Button Content="Neueste behalten" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                Command="{Binding Duplicates.KeepNewestCommand}"
                                ToolTip="In jeder Gruppe die zuletzt geänderte Kopie behalten und alle anderen vormerken" />
                        <Button Content="Kürzesten Pfad behalten" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                Command="{Binding Duplicates.KeepShortestCommand}"
                                ToolTip="In jeder Gruppe die Kopie mit dem kürzesten Pfad behalten und alle anderen vormerken" />
                        <Button Content="Vormerkung aufheben" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                Command="{Binding Duplicates.ClearMarksCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Duplicates.MarkedText}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Style="{StaticResource DimText}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Gleicher Inhalt heißt nicht: überflüssig. Manche Programme erwarten ihre Kopie an einem festen Ort. Verschoben wird erst im Auswahlkorb unten nach Bestätigung." />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
